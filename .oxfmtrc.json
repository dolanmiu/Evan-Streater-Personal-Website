{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "trailingComma": "es5",
  "singleAttributePerLine": false,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".git/**",
    ".next/**",
    ".opencode/**",
    "coverage/**",
    "node_modules/**",
    "package-lock.json"
  ]
}
